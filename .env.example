# Copy to .env and fill in. All values are optional except ADMIN_PASSWORD (needed for /admin).
PORT=3000
# Admin view at /admin (HTTP Basic auth)
ADMIN_USER=admin
ADMIN_PASSWORD=
# FSI WhatsApp number with country code, digits only (e.g. 91XXXXXXXXXX). Shows "Continue on WhatsApp" after an enquiry.
WHATSAPP_NUMBER=
# CRM: each new lead is POSTed here as JSON {event:"lead.created", lead:{...}}, retried 3 times
CRM_WEBHOOK_URL=
# If set, requests carry X-KCCC-Signature: sha256=<HMAC of the body> so the CRM can verify them
CRM_WEBHOOK_SECRET=
# Where leads.json and events.jsonl are stored
DATA_DIR=./data
# Set to 1 behind a reverse proxy (nginx, Render, etc.) so rate limits use the real client IP
TRUST_PROXY=0
# Origins allowed to post enquiries cross-origin, for the standalone HTML build (comma-separated, or *)
ALLOWED_ORIGINS=
